{
  "name": "sanctuary-social",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sanctuary/api & npm run dev --workspace @sanctuary/web",
    "dev:api": "npm run dev --workspace @sanctuary/api",
    "dev:web": "npm run dev --workspace @sanctuary/web",
    "dev:mobile": "npm run dev --workspace @deoly/mobile",
    "build": "npm run build --workspace @sanctuary/shared && npm run build --workspace @sanctuary/api && npm run build --workspace @sanctuary/web",
    "test": "npm run test --workspace @sanctuary/api",
    "db:generate": "npm run prisma:generate --workspace @sanctuary/api",
    "db:migrate": "npm run prisma:migrate --workspace @sanctuary/api",
    "db:seed": "npm run prisma:seed --workspace @sanctuary/api"
  }
}
